# ============================================
# Railway Dashboard - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Frontend
FRONTEND_PORT=5500
FRONTEND_URL=http://localhost:5500

# API Keys
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
RAILWAY_API_KEY=your_railway_api_key_here

# Database (for production)
MONGODB_URI=mongodb://localhost:27017/railway-dashboard
DB_NAME=railway_dashboard

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# AI Configuration
AI_CONFLICT_THRESHOLD=0.85
AI_DELAY_PREDICTION_MODEL=cascade_v2
AI_FUEL_OPTIMIZATION=enabled

# Kavach Configuration
KAVACH_ENABLED=true
KAVACH_COMMUNICATION_PORT=8080

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev
