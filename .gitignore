# Environment & Secret Keys (DO NOT COMMIT)
.env
.env.*
*.env
**/.env
**/.env.*
*.key
*.pem
*.cert
certs/
**/certs/

# Node modules
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python byte-compiled / optimized files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Data & Database exports
data/kavach_db_export.*
data/api_responses/*.json
data/raw/*.json
data/geojson/*.geojson
data/mock/*.json
data/seed/*.json
*.parquet
*.csv

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker build & system logs
*.log

