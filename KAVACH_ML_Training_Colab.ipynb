   "source": [
    "# 🚆 PROJECT-KAVACH: AI/ML Model Training Pipeline\n",
    "### Automatic Train Protection (ATP) & Anti-Collision System\n",
    "\n",
    "This Google Colab notebook trains two high-performance Machine Learning models on Indian Railways Telemetry data:\n",
    "1. **Collision Risk Classifier** (Predicts: `NORMAL`, `WARNING`, `CRITICAL`)\n",
    "2. **Emergency Braking Distance (EBD) Regressor** (Predicts required stopping distance in meters)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install Required Libraries\n",
    "!pip install -q pandas numpy scikit-learn xgboost joblib matplotlib seaborn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Import Libraries & Load Training Dataset\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, accuracy_score, confusion_matrix\n",
    "from xgboost import XGBRegressor\n",
    "import joblib\n",
    "\n",
    "# Upload 'kavach_ml_training_data.csv' or load directly\n",
    "try:\n",
    "    df = pd.read_csv('kavach_ml_training_data.csv')\n",
    "    print(f\"✅ Dataset Loaded Successfully! Shape: {df.shape}\")
    "    print(df.head())\n",
    "except Exception as e:\n",
    "    print(\"❌ Upload 'kavach_ml_training_data.csv' to Google Colab files section!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Feature Engineering & Preprocessing\n",
    "X = df.drop(columns=['collision_risk', 'calculated_ebd_m'])\n",
    "y_class = df['collision_risk']\n",
    "y_reg = df['calculated_ebd_m']\n",
    "\n",
    "# One-Hot Encoding for Categorical Variables\n",
    "X_encoded = pd.get_dummies(X, columns=['train_category', 'signal_status', 'track_type'], drop_first=True)\n",
    "\n",
    "# Split Data (80% Train, 20% Test)\n",
    "X_train, X_test, y_train_c, y_test_c = train_test_split(X_encoded, y_class, test_size=0.2, random_state=42)\n",
    "_, _, y_train_r, y_test_r = train_test_split(X_encoded, y_reg, test_size=0.2, random_state=42)\n",
    "\n",
    "print(f\"Training Samples: {len(X_train)} | Testing Samples: {len(X_test)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Train Model 1 - Collision Risk Classifier (Random Forest)\n",
    "clf_model = RandomForestClassifier(n_estimators=150, max_depth=12, random_state=42)\n",
    "clf_model.fit(X_train, y_train_c)\n",
    "\n",
    "y_pred_c = clf_model.predict(X_test)\n",
    "acc = accuracy_score(y_test_c, y_pred_c)\n",
    "print(f\"🎯 Collision Risk Classifier Accuracy: {acc * 100:.2f}%\")\n",
    "print(\"\\nClassification Report:\\n\", classification_report(y_test_c, y_pred_c))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Plot Confusion Matrix\n",
    "cm = confusion_matrix(y_test_c, y_pred_c, labels=clf_model.classes_)\n",
    "plt.figure(figsize=(6, 4))\n",
    "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=clf_model.classes_, yticklabels=clf_model.classes_)\n",
    "plt.title('PROJECT-KAVACH Collision Risk Confusion Matrix')\n",
    "plt.xlabel('Predicted')\n",
    "plt.ylabel('Actual')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 6: Save Trained Model Bundle\n",
    "model_bundle = {\n",
    "    'classifier': clf_model,\n",
    "    'feature_columns': list(X_encoded.columns)\n",
    "}\n",
    "joblib.dump(model_bundle, 'kavach_collision_model.pkl')\n",
    "print(\"💾 Model saved as 'kavach_collision_model.pkl'! Download this file from Colab to use in your local project.\")"
   ]
  }
 ],
